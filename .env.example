APP_NAME="BP Fitness"
APP_ENV=staging
# APP_ENV=local,staging,production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC # Asia/Dhaka # America/New_York

# ---------- CORS SETUP ----------
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5174
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,127.0.0.1:5173,127.0.0.1:5174
SESSION_DOMAIN=127.0.0.1
SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=false # true=cookies will be sent only via HTTPs
# ---------- CORS SETUP ----------

# ---------- NGROK ----------
# APP_URL=https://your-ngrok-domain.ngrok-free.dev
# SESSION_DOMAIN=.ngrok-free.dev
# SESSION_SECURE_COOKIE=false
# ---------- NGROK ----------

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- DATABASE ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bp_fitness
DB_USERNAME=root
DB_PASSWORD=
# ---------- DATABASE ----------

SESSION_LIFETIME=1440 
# SESSION_LIFETIME = 1440 = 60 min * 24 h = 1 day
SESSION_ENCRYPT=false
SESSION_PATH=/

SANCTUM_TOKEN_TTL=20160
# SANCTUM_TOKEN_TTL = 20160 = 60 * 24 * 14 = 14 days

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
FILEPOND_DISK=public
DISPUTE_EVIDENCE_DISK=public
# FILEPOND_DISK=public # keep this same as FILESYSTEM_DISK
# QUEUE_CONNECTION=sync
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

########################### SMTP ###########################
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
########################### SMTP ###########################

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# AUTH_GUARD=sanctum

# -------- Laravel Scout --------
SCOUT_DRIVER=database

# -------- FIREBASE PUSH NOTIFICATION --------
FIREBASE_CREDENTIALS=
FIREBASE_VAPID_KEY=
FIREBASE_PROJECT_ID=

# -------- AI --------
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---------------- Master Admin keys ----------------
OPENROUTER_API_KEY=
GROQ_API_KEY=
# ---------------- Master Admin keys ----------------

# -------- AI --------

# -------------- REVERB CREDENTIALS --------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SERVER_PORT=8080
REVERB_SCHEME=http
# -------------- REVERB CREDENTIALS --------------

# --------------------- SOCIAL LOGINS ---------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:8000/auth/google/callback
# --------------------- SOCIAL LOGINS ---------------------

# --------------------- STRIPE ---------------------
# dynamically set-up using EnvLoadServiceProvider & admin dashboard
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_WEBHOOK_SECRET=
# --------------------- STRIPE ---------------------

# --------------------- REVENUECAT ---------------------
REVENUECAT_PUBLIC_API_KEY=
REVENUECAT_SECRET_KEY=
REVENUECAT_AUTH_TOKEN=
REVENUECAT_PROJECT_ID=
# --------------------- REVENUECAT ---------------------

# --------------------- CUSTOM PERMISSIONS ---------------------
CAN_CHANGE_OWN_EMAIL=true
CAN_CHANGE_OWN_PASSWORD=true

# STRIPE_CURRENCY=usd   # managed via admin dashboard
ADMIN_FEE_PERCENTAGE=5
# --------------------- CUSTOM PERMISSIONS ---------------------
